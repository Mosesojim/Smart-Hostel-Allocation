{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "bun run --cwd artifacts/smart-hostel-allocation dev",
    "dev": "bun run --cwd artifacts/smart-hostel-allocation dev",
    "build": "bun run --cwd artifacts/smart-hostel-allocation build 2>/dev/null || (cd artifacts/smart-hostel-allocation && npm run build)",
    "typecheck": "bun run --cwd artifacts/smart-hostel-allocation typecheck",
    "lint": "bun run --cwd artifacts/smart-hostel-allocation typecheck"
  },
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ]
}
